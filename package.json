{
  "name": "dsh-prompt-optimizer",
  "version": "1.0.0",
  "description": "Composer button for DeepSeek Harness that rewrites the current draft into a structured prompt and puts it back into the input box.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "prompt",
    "prompt-engineering",
    "composer",
    "ui-plugin"
  ],
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/<your-name>/dsh-prompt-optimizer.git"
  },
  "bugs": {
    "url": "https://github.com/<your-name>/dsh-prompt-optimizer/issues"
  },
  "homepage": "https://github.com/<your-name>/dsh-prompt-optimizer#readme",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
